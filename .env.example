# Skare Store — Environment Variables Example
# Copy this file to `.env` and fill in real values.
# NEVER commit the real `.env` file!

# SQLite database location (relative path)
DATABASE_URL="file:./dev.db"

# NextAuth.js — generate a strong random secret with: openssl rand -base64 32
NEXTAUTH_SECRET="replace-with-strong-random-secret-min-32-chars"

# Public URL of the deployed site
NEXTAUTH_URL="http://localhost:3000"

# Admin email (the user with this email will have ADMIN role in DB)
# Replace with your own email
ADMIN_EMAIL="your-admin-email@example.com"
